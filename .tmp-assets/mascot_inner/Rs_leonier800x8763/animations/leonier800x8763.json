{"\u0066\u006f\u0072\u006d\u0061\u0074\u005f\u0076\u0065\u0072\u0073\u0069\u006f\u006e":"\u0031\u002e\u0038\u002e\u0030","\u0061\u006e\u0069\u006d\u0061\u0074\u0069\u006f\u006e\u0073":{"\u0061\u006e\u0069\u006d\u0061\u0074\u0069\u006f\u006e\u002e\u0077\u006b\u0066\u0035\u006c\u0030\u0079\u006b\u0069\u0069\u0075\u0076\u0037\u0076\u006e\u0076\u0062\u0061\u006d\u0064\u0039\u0074\u0061\u0066\u0068":{"\u0061\u006e\u0069\u006d\u0061\u0074\u0069\u006f\u006e\u005f\u006c\u0065\u006e\u0067\u0074\u0068":3,"\u006c\u006f\u006f\u0070":true,"\u0062\u006f\u006e\u0065\u0073":{"\u0077\u0061\u0069\u0073\u0074":{"\u0072\u006f\u0074\u0061\u0074\u0069\u006f\u006e":{"\u0030\u002e\u0030":["\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0075\u006c\u0076\u0035\u0075\u0072\u006d\u0070\u0070\u0071\u0074\u0062\u0067\u0035\u0038\u0075\u0068\u0037\u0065\u0039\u0037\u006d\u0073\u0074\u0033","\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0075\u006c\u0076\u0035\u0075\u0072\u006d\u0070\u0070\u0071\u0074\u0062\u0067\u0035\u0038\u0075\u0068\u0037\u0065\u0039\u0037\u006d\u0073\u0074\u0033","\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0075\u006c\u0076\u0035\u0075\u0072\u006d\u0070\u0070\u0071\u0074\u0062\u0067\u0035\u0038\u0075\u0068\u0037\u0065\u0039\u0037\u006d\u0073\u0074\u0033"],"\u0031\u002e\u0035":[-2.5,"\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0075\u006c\u0076\u0035\u0075\u0072\u006d\u0070\u0070\u0071\u0074\u0062\u0067\u0035\u0038\u0075\u0068\u0037\u0065\u0039\u0037\u006d\u0073\u0074\u0033","\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0075\u006c\u0076\u0035\u0075\u0072\u006d\u0070\u0070\u0071\u0074\u0062\u0067\u0035\u0038\u0075\u0068\u0037\u0065\u0039\u0037\u006d\u0073\u0074\u0033"],"\u0033\u002e\u0030":["\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0075\u006c\u0076\u0035\u0075\u0072\u006d\u0070\u0070\u0071\u0074\u0062\u0067\u0035\u0038\u0075\u0068\u0037\u0065\u0039\u0037\u006d\u0073\u0074\u0033","\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0075\u006c\u0076\u0035\u0075\u0072\u006d\u0070\u0070\u0071\u0074\u0062\u0067\u0035\u0038\u0075\u0068\u0037\u0065\u0039\u0037\u006d\u0073\u0074\u0033","\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0075\u006c\u0076\u0035\u0075\u0072\u006d\u0070\u0070\u0071\u0074\u0062\u0067\u0035\u0038\u0075\u0068\u0037\u0065\u0039\u0037\u006d\u0073\u0074\u0033"]}}}},"\u0061\u006e\u0069\u006d\u0061\u0074\u0069\u006f\u006e\u002e\u0074\u0032\u0072\u0039\u0073\u0061\u0074\u0073\u007a\u0079\u0037\u006c\u006d\u0062\u0072\u0062\u0036\u0079\u007a\u0078\u006a\u0071\u006e\u006c\u0071":{"\u0061\u006e\u0069\u006d\u0061\u0074\u0069\u006f\u006e\u005f\u006c\u0065\u006e\u0067\u0074\u0068":3,"\u006c\u006f\u006f\u0070":true,"\u0062\u006f\u006e\u0065\u0073":{"\u0068\u0065\u0061\u0064":{"\u0072\u006f\u0074\u0061\u0074\u0069\u006f\u006e":{"\u0030\u002e\u0030":["\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0075\u006c\u0076\u0035\u0075\u0072\u006d\u0070\u0070\u0071\u0074\u0062\u0067\u0035\u0038\u0075\u0068\u0037\u0065\u0039\u0037\u006d\u0073\u0074\u0033","\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0075\u006c\u0076\u0035\u0075\u0072\u006d\u0070\u0070\u0071\u0074\u0062\u0067\u0035\u0038\u0075\u0068\u0037\u0065\u0039\u0037\u006d\u0073\u0074\u0033","\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0078\u0064\u006b\u0078\u0074\u0076\u006c\u0038\u0079\u0031\u0073\u0076\u006f\u0062\u0072\u006e\u0062\u0030\u006e\u007a\u0072\u007a\u0066\u0070\u0065"],"\u0031\u002e\u0035":[2.5,"\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0075\u006c\u0076\u0035\u0075\u0072\u006d\u0070\u0070\u0071\u0074\u0062\u0067\u0035\u0038\u0075\u0068\u0037\u0065\u0039\u0037\u006d\u0073\u0074\u0033","\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u002e\u0078\u0064\u006b\u0078\u0074\u0076\u006c\u0038\u0079\u0031\u0073\u0076\u006f\u0062\u0072\u006e\u0062\u0030\u006e\u007a\u0072\u007a\u0066\u0070\u0065"],"\u0033\u002e\u0030":["\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0